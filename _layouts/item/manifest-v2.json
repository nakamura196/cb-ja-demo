{%- comment -%}
    IIIF Presentation 2 manifest for an item, generated by cb_page_gen
    (see `page_gen` in _config.yml: template manifest-v2, template_override true,
    permalink /iiif/2/:name/manifest.json). The same item as the version 3
    manifest (manifest.json), for viewers and tools that read only version 2.

    Images are found as in manifest.json. `iiif_image: 2` points each image at
    its Image API 2 level 0 folder (objects/iiif/2/<name>/, made by
    `rake generate_iiif`), or at the image file itself if there is none.

    Version 2 has no language maps here: labels and values are plain strings.
    rights → license (a URI), requiredStatement → attribution,
    homepage → related, behavior (`iiif_behavior` column, else `iiif-behavior`
    in _config.yml) → the sequence's viewingHint. There is no provider in version 2.
{%- endcomment -%}
{%- assign manifest_id = page.permalink | default: page.url | absolute_url -%}
{%- assign manifest_base = manifest_id | split: '/' | pop | join: '/' -%}
{%- assign children = site.data[site.metadata] | where_exp: 'item', 'item.parentid == page.objectid' -%}
{%- if children.size == 0 -%}{%- assign children = site.data[site.metadata] | where_exp: 'item', 'item.objectid == page.objectid' -%}{%- endif -%}
{%- assign fields = site.data.config-metadata -%}
{%- assign behavior = page.iiif_behavior | default: site['iiif-behavior'] | strip -%}
{%- unless behavior == "individuals" or behavior == "paged" or behavior == "continuous" %}{% assign behavior = nil %}{% endunless -%}
{
  "@context": "http://iiif.io/api/presentation/2/context.json",
  "@id": {{ manifest_id | jsonify }},
  "@type": "sc:Manifest",
  "label": {{ page.title | jsonify }},
  {%- if page.description %}
  "description": {{ page.description | strip_html | jsonify }},
  {%- endif %}
  "metadata": [
    {%- assign first = true -%}
    {%- for f in fields -%}
    {%- assign v = page[f.field] -%}
    {%- if v and v != "" and f.field != "title" and f.field != "description" and f.field != "manifest" %}
    {% unless first %},{% endunless %}{ "label": {{ f.display_name | default: f.field | jsonify }}, "value": {{ v | jsonify }} }
    {%- assign first = false -%}
    {%- endif -%}
    {%- endfor %}
  ],
  {%- if page.rights %}
  "attribution": {{ page.rights | jsonify }},
  {%- endif %}
  {%- if page.rightsstatement contains "creativecommons.org" or page.rightsstatement contains "rightsstatements.org" %}
  "license": {{ page.rightsstatement | jsonify }},
  {%- endif %}
  {%- if page.viewing_direction == "right-to-left" or page.viewing_direction == "left-to-right" %}
  "viewingDirection": {{ page.viewing_direction | jsonify }},
  {%- endif %}
  "related": { "@id": {{ '/items/' | append: page.base_filename | append: '.html' | absolute_url | jsonify }}, "format": "text/html" },
  {%- if page.image_thumb %}
  "thumbnail": { "@id": {{ page.image_thumb | absolute_url | jsonify }} },
  {%- endif %}
  "sequences": [ {
    "@id": {{ manifest_base | append: '/sequence/normal' | jsonify }},
    "@type": "sc:Sequence",
    {%- if behavior %}
    "viewingHint": {{ behavior | jsonify }},
    {%- endif %}
    "canvases": [
      {%- assign n = 0 -%}
      {%- for child in children -%}
      {%- assign img = child.object_location | iiif_image: 2 -%}
      {%- if img -%}
      {%- assign n = n | plus: 1 -%}
      {%- capture canvas_id %}{{ manifest_base }}/canvas/p{{ n }}{% endcapture -%}
      {%- if n > 1 %},{% endif %}
      {
        "@id": {{ canvas_id | jsonify }},
        "@type": "sc:Canvas",
        "label": {{ child.title | default: n | append: '' | jsonify }},
        "width": {{ img.width }},
        "height": {{ img.height }},
        {%- if child.image_thumb %}
        "thumbnail": { "@id": {{ child.image_thumb | absolute_url | jsonify }} },
        {%- endif %}
        "images": [ {
          "@id": {{ canvas_id | append: '/image' | jsonify }},
          "@type": "oa:Annotation",
          "motivation": "sc:painting",
          "on": {{ canvas_id | jsonify }},
          "resource": {
            "@id": {{ img.id | jsonify }},
            "@type": "dctypes:Image",
            "format": {{ img.format | jsonify }},
            "width": {{ img.width }},
            "height": {{ img.height }}
            {%- if img.service %},
            "service": { "@context": "http://iiif.io/api/image/2/context.json", "@id": {{ img.service | jsonify }}, "profile": "http://iiif.io/api/image/2/level0.json" }
            {%- endif %}
          }
        } ]
      }
      {%- endif -%}
      {%- endfor %}
    ]
  } ]
}
