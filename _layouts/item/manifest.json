{%- comment -%}
    IIIF Presentation 3 manifest for an item, generated by cb_page_gen
    (see `page_gen` in _config.yml: template manifest, template_override true).

    Images are the item's own files: object_location for a single image item,
    or each child's object_location for a compound object. Nothing else is
    needed; the image size is read from the file (`iiif_image` filter in
    _plugins/cb_iiif.rb). If `rake generate_iiif` has been run, each image also
    gets its level 0 Image API service (fixed sizes, plus tiles for large images).

    Metadata fields and labels come from _data/config-metadata.csv.
{%- endcomment -%}
{%- assign lang = site.lang | default: 'en' -%}
{%- assign t = site.data.locale[site.lang] -%}
{%- assign manifest_id = '/manifests/' | append: page.base_filename | append: '.json' | absolute_url -%}
{%- assign children = site.data[site.metadata] | where_exp: 'item', 'item.parentid == page.objectid' -%}
{%- if children.size == 0 -%}{%- assign children = site.data[site.metadata] | where_exp: 'item', 'item.objectid == page.objectid' -%}{%- endif -%}
{%- assign fields = site.data.config-metadata -%}
{
  "@context": "http://iiif.io/api/presentation/3/context.json",
  "id": {{ manifest_id | jsonify }},
  "type": "Manifest",
  "label": { {{ lang | jsonify }}: [ {{ page.title | jsonify }} ] },
  {%- if page.description %}
  "summary": { {{ lang | jsonify }}: [ {{ page.description | strip_html | jsonify }} ] },
  {%- endif %}
  "metadata": [
    {%- assign first = true -%}
    {%- for f in fields -%}
    {%- assign v = page[f.field] -%}
    {%- if v and v != "" and f.field != "title" and f.field != "description" and f.field != "manifest" %}
    {% unless first %},{% endunless %}{ "label": { {{ lang | jsonify }}: [ {{ f.display_name | default: f.field | jsonify }} ] }, "value": { "none": [ {{ v | jsonify }} ] } }
    {%- assign first = false -%}
    {%- endif -%}
    {%- endfor %}
  ],
  {%- if page.rights %}
  "requiredStatement": {
    "label": { {{ lang | jsonify }}: [ {{ t.rights | default: "Rights" | jsonify }} ] },
    "value": { "none": [ {{ page.rights | jsonify }} ] }
  },
  {%- endif %}
  {%- if page.rightsstatement contains "creativecommons.org" or page.rightsstatement contains "rightsstatements.org" %}
  "rights": {{ page.rightsstatement | replace: "https://creativecommons.org", "http://creativecommons.org" | jsonify }},
  {%- endif %}
  {%- if page.viewing_direction == "right-to-left" or page.viewing_direction == "left-to-right" %}
  "viewingDirection": {{ page.viewing_direction | jsonify }},
  {%- endif %}
  "homepage": [ {
    "id": {{ '/items/' | append: page.base_filename | append: '.html' | absolute_url | jsonify }},
    "type": "Text",
    "label": { {{ lang | jsonify }}: [ {{ page.title | jsonify }} ] },
    "format": "text/html"
  } ],
  {%- if page.image_thumb %}
  "thumbnail": [ { "id": {{ page.image_thumb | absolute_url | jsonify }}, "type": "Image", "format": "image/jpeg" } ],
  {%- endif %}
  "provider": [ {
    "id": {{ '/' | absolute_url | jsonify }},
    "type": "Agent",
    "label": { {{ lang | jsonify }}: [ {{ site.title | jsonify }} ] },
    "homepage": [ { "id": {{ '/' | absolute_url | jsonify }}, "type": "Text", "label": { {{ lang | jsonify }}: [ {{ site.title | jsonify }} ] }, "format": "text/html" } ]
  } ],
  "items": [
    {%- assign n = 0 -%}
    {%- for child in children -%}
    {%- assign img = child.object_location | iiif_image -%}
    {%- if img -%}
    {%- assign n = n | plus: 1 -%}
    {%- capture canvas_id %}{{ manifest_id | remove: '.json' }}/canvas/p{{ n }}{% endcapture -%}
    {%- if n > 1 %},{% endif %}
    {
      "id": {{ canvas_id | jsonify }},
      "type": "Canvas",
      "label": { "none": [ {{ child.title | default: n | append: '' | jsonify }} ] },
      "width": {{ img.width }},
      "height": {{ img.height }},
      {%- if child.image_thumb %}
      "thumbnail": [ { "id": {{ child.image_thumb | absolute_url | jsonify }}, "type": "Image", "format": "image/jpeg" } ],
      {%- endif %}
      "items": [ {
        "id": {{ canvas_id | append: '/page' | jsonify }},
        "type": "AnnotationPage",
        "items": [ {
          "id": {{ canvas_id | append: '/page/image' | jsonify }},
          "type": "Annotation",
          "motivation": "painting",
          "target": {{ canvas_id | jsonify }},
          "body": {
            "id": {{ img.id | jsonify }},
            "type": "Image",
            "format": {{ img.format | jsonify }},
            "width": {{ img.width }},
            "height": {{ img.height }}
            {%- if img.service %},
            "service": [ { "id": {{ img.service | jsonify }}, "type": "ImageService3", "profile": "level0" } ]
            {%- endif %}
          }
        } ]
      } ]
    }
    {%- endif -%}
    {%- endfor %}
  ]
}
